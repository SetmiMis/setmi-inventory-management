# Copy to .env.local (local) or add in the Vercel project settings (online). Never commit real values.
# Both values are public by design (the browser needs them); security comes from Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# The service-role (secret) key is NOT used by this app. Do not add it.
