# Copy to backend/.env.local and fill in. Never commit real values.
# Both Supabase values are public by design (the browser app uses the same two); security comes from the person's
# sign-in token and the database rules. The service-role (secret) key is NOT used here. Do not add it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# The address of the website (frontend): the only browser origin allowed to call this API.
FRONTEND_URL=http://localhost:3000
PORT=4000
NODE_ENV=development
